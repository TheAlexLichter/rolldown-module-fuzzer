{
  "name": "rolldown-rollup-compat",
  "version": "0.0.0",
  "private": true,
  "description": "Seeded differential module-graph tests for Rolldown and Rollup compatibility.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "diff": "vp exec node src/cli.ts",
    "diff:fuzz": "vp run diff -- --fuzz --seed 0 --cases 25 --max-width 6 --max-depth 8 --paths static,namespace,dynamic,default,named-reexport,star-reexport",
    "diff:smoke": "vp run diff -- --family all --seeds 1",
    "check:repl-contract": "vp exec node src/repl-contract.ts",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
    "bumpp": "^11.1.0",
    "rolldown": "^1.0.2",
    "rollup": "^4.60.4",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.20"
  },
  "packageManager": "pnpm@11.2.2",
  "inlinedDependencies": {
    "@rolldown/pluginutils": "1.0.1",
    "rolldown": "1.0.2",
    "rollup": "4.60.4"
  }
}
